#!/bin/sh
set -eu

xset s off || true
xset s noblank || true
xset -dpms || true
setterm -blank 0 -powerdown 0 || true
amixer set Master 80% unmute >/dev/null 2>&1 || true
amixer set Speaker 80% unmute >/dev/null 2>&1 || true

exec /opt/clarity-venv/bin/python /opt/clarity-appliance/app/clarity_appliance.py

